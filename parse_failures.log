    return re.sub(r'\s+', ' ', text.strip())

def _strip_json_comments(text: str) -> str:
    # Remove comments from JSON-like text
    return re.sub(r'//.*', '', text).replace('```', '').strip()

def _find_json_objects(text: str) -> List[Dict]:
    # Find and parse JSON objects in the text
    return json.loads(text)

def _try(candidate: str) -> None:
    try:
        ev = json.loads(candidate)
        key = (ev["title"], ev["start_ts"], ev["end_ts"])
        if key in seen:
            return
        seen.add(key)
        events.append(ev)
    except json.JSONDecodeError:
        pass

def _extract_calendar_events(self, "text": str) -> List[Dict]:
    """
    Extract calendar events from the given text.
    
    :param text: Input text containing JSON-like structures.
    :return: List of extracted calendar events.
    """
    events, seen = [], set()
    text = _normalize_json_text(text)

    def _try(candidate: str) -> None:
        try:
            ev = json.loads(candidate)
            key = (ev["title"], ev["start_ts"], ev["end_ts"])
            if key in seen:
                return
            seen.add(key)
            events.append(ev)
        except json.JSONDecodeError:
            pass

    for m in re.finditer(r"```\s*calendar\b[^\n]*\n?(.*?)```",
                         text, re.DOTALL | re.IGNORECASE):
        block = m.group(1).strip()
        block = _strip_json_comments(block)
        if block.lower().startswith("json"):
            block = block[4:].lstrip()
        for obj in _find_json_objects(block):
            _try(obj)

    for m in re.finditer(r"```[^\n]*\n(.*?)```", text, re.DOTALL):
        block = m.group(1).strip()
        block = _strip_json_comments(block)
        for obj in _find_json_objects(block):
            _try(obj)

    for obj in _find_json_objects(_strip_json_comments(text)):
        _try(obj)

    if not events and any(k in text for k in ('"title"', "'title'", '"start', 'calendar')):
        try:
            with open("parse_failures.log", "a", encoding="utf-8") as f:
                f.write("=" * 60 + "\n")
                f.write(f"TIMESTAMP: {datetime.now().isoformat()}\n")
                f.write(text[:4000] + "\n")
        except Exception:
            pass

    return events
```

This code includes the following improvements:
1. Proper normalization of text to remove extra whitespace.
2. Removal of comments from JSON-like text.
3. Parsing of JSON objects in the text.
4. Error handling for JSON decoding errors.
5. Logging of parse failures.

